.next
node_modules
# Secrets. Note `.env` matches ONLY a file named exactly .env -- it does not
# cover .env.example, which is why that is listed explicitly.
.env
.env.*
!.env.sample
coverage
dist
*.tsbuildinfo
supabase/.branches
supabase/.temp

# Database dumps contain real farm data
backups

# Verification builds (kept separate so they never clobber a running dev server)
.next-verify

# Cloudflare/OpenNext build output and local runtime state -- .wrangler/ in
# particular caches request/response data from `wrangler dev`/`cf:preview`
# (miniflare's local SQLite stores), which can include the env vars
# `.env.local` was loaded with. Neither is ever meant to be committed.
.open-next
.wrangler
.dev.vars

# Claude Code machine-local settings (permissions, per-machine config).
# launch.json is intentionally shared; settings.local.json is not.
.claude/settings.local.json
