{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layerflow",
  // Points at the custom worker wrapper (workers/cron-worker.ts), not
  // OpenNext's generated .open-next/worker.js directly -- the wrapper is
  // what adds the scheduled() handler for the daily subscription-email
  // cron alongside the untouched Next.js fetch handler. See that file.
  "main": "workers/cron-worker.ts",
  "compatibility_date": "2026-09-04",
  // Required for OpenNext's Node.js-runtime mode, and covers the app's
  // node:crypto randomUUID() usage (app/(app)/team/actions.ts,
  // app/onboarding/actions.ts, app/(app)/farms/actions.ts).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Same schedule vercel.json used: daily at 10:00 PM UTC.
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  // Non-secret runtime vars only -- this file is committed to git. Actual
  // credentials (SUPABASE_SERVICE_ROLE_KEY, BREVO_API_KEY, CRON_SECRET,
  // BREVO_WEBHOOK_SECRET) live as Cloudflare Secrets (dashboard or
  // `wrangler secret put`), never here. See docs/deployment.md.
  "vars": {
    "ADMIN_EMAILS": "marlonsinadjan89@gmail.com",
    "EMAIL_FROM": "LayerFlow <marlonsinadjan89@gmail.com>",
    "EMAIL_PROVIDER": "brevo",
    // Safe to commit -- meant to be public/embedded in the client bundle.
    // Needed at runtime too (e.g. next.config.ts's CSP header generation),
    // not just baked into the build.
    "NEXT_PUBLIC_SUPABASE_URL": "https://dvsvanhbpbbmtqwaulyz.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_YPsnO1h2cnZ-zuVgPe2atw_eqj_ttA3",
    "NEXT_PUBLIC_APP_URL": "https://layerflow.marlonsinadjan89.workers.dev"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
